rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection test document
    match /test/{testId} {
      allow read, write: if isValidId(testId);
    }

    // Users and sessions
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Models, vaults, and intelligence stores
    match /models/{modelId} {
      allow read, write: if isValidId(modelId);

      match /mediaVault/{photoId} {
        allow read, write: if isValidId(modelId) && isValidId(photoId);
      }

      match /voiceVault/{clipId} {
        allow read, write: if isValidId(modelId) && isValidId(clipId);
      }

      match /leads/{leadId} {
        allow read, write: if isValidId(modelId) && isValidId(leadId);
      }

      match /chats/{chatId} {
        allow read, write: if isValidId(modelId) && isValidId(chatId);

        match /messages/{messageId} {
          allow read, write: if isValidId(modelId) && isValidId(chatId) && isValidId(messageId);
        }
      }
    }
  }
}
